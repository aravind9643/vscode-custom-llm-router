{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "bundle",
      "group": "build",
      "problemMatcher": "$esbuild"
    },
    {
      "label": "mock server",
      "type": "shell",
      "command": "python mock_llm_server.py 31415",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^__never__$" },
        "background": { "activesBegin": true, "beginsPattern": ".", "endsPattern": "Mock Server running" }
      }
    },
    {
      "label": "bundle + mock server",
      "dependsOn": ["npm: bundle", "mock server"]
    }
  ]
}
