# Local Model Providers Configuration Template
# Copy this file to .env and fill in your values

# FreeLLMAPI (Local proxy / default port 31415)
FREELLMAPI_URL=http://127.0.0.1:31415
FREELLMAPI_KEY=your-freellmapi-key-here
FREELLMAPI_VSCODE_SECRET=${input:chat.lm.secret.50cd2a8f}

# OmniRoute (Local routing bridge / default port 20128)
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_KEY=your-omniroute-key-here
OMNIROUTE_VSCODE_SECRET=${input:chat.lm.secret.5048ce49}
