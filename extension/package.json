{
  "name": "vscode-custom-llm-router",
  "displayName": "Custom LLM Router",
  "description": "Seamlessly connect FreeLLMAPI & OmniRoute local models directly into VS Code Copilot & Chat",
  "version": "1.0.0",
  "publisher": "aravind9643",
  "repository": {
    "type": "git",
    "url": "https://github.com/aravind9643/vscode-custom-llm-router.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-custom-llm-router.showMenu",
        "title": "Custom LLM Router: Show Menu",
        "category": "Custom LLM"
      },
      {
        "command": "vscode-custom-llm-router.syncModels",
        "title": "Custom LLM Router: Sync Models",
        "category": "Custom LLM"
      },
      {
        "command": "vscode-custom-llm-router.checkStatus",
        "title": "Custom LLM Router: Check Endpoints Status",
        "category": "Custom LLM"
      },
      {
        "command": "vscode-custom-llm-router.selectProfile",
        "title": "Custom LLM Router: Switch Model Profile",
        "category": "Custom LLM"
      },
      {
        "command": "vscode-custom-llm-router.configureEnv",
        "title": "Custom LLM Router: Configure .env Endpoints & Keys",
        "category": "Custom LLM"
      },
      {
        "command": "vscode-custom-llm-router.configureRules",
        "title": "Custom LLM Router: Configure models.config.json & Providers",
        "category": "Custom LLM"
      },
      {
        "command": "vscode-custom-llm-router.addProvider",
        "title": "Custom LLM Router: Add Custom Model Provider",
        "category": "Custom LLM"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vscode-custom-llm-router.showMenu"
        },
        {
          "command": "vscode-custom-llm-router.syncModels"
        },
        {
          "command": "vscode-custom-llm-router.addProvider"
        },
        {
          "command": "vscode-custom-llm-router.checkStatus"
        },
        {
          "command": "vscode-custom-llm-router.selectProfile"
        },
        {
          "command": "vscode-custom-llm-router.configureEnv"
        },
        {
          "command": "vscode-custom-llm-router.configureRules"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "custom-llm-router",
        "displayName": "Custom LLM Router"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.5"
  }
}
